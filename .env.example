# Only needed if you later call back into Jira's REST API (e.g. to comment on the issue).
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Aetherion agent-run API. Left blank -> call_agent() runs in dry-run mode (logs only).
AGENT_RUN_API_BASE_URL=
AGENT_ID=
AGENT_NAME=

# OAuth client-credentials token for the agent-run API call above.
# e.g. https://api.sbox.aetherion.io/auth/token
AUTH_TOKEN_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_API_KEY=
AUTH_TENANT_ID=
