# Only needed if you later call back into Jira's REST API (e.g. to comment on the issue).
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Aetherion agent-run API. Flip this one flag to switch which credential bundle
# below is active instead of editing every value by hand.
USE_TEST_ENV=false

# --- TEST_* bundle (used when USE_TEST_ENV=true) ---
TEST_AGENT_RUN_API_BASE_URL=
TEST_AGENT_ID=
TEST_AGENT_NAME=
TEST_SCRAPE_PROMOTER_AGENT_ID=
TEST_SCRAPE_PROMOTER_AGENT_NAME=
TEST_AUTH_TOKEN_URL=
TEST_AUTH_CLIENT_ID=
TEST_AUTH_CLIENT_SECRET=
TEST_AUTH_API_KEY=
TEST_AUTH_TENANT_ID=

# --- ASURINT_* bundle (used when USE_TEST_ENV=false) ---
ASURINT_AGENT_RUN_API_BASE_URL=
ASURINT_AGENT_ID=
ASURINT_AGENT_NAME=
ASURINT_SCRAPE_PROMOTER_AGENT_ID=
ASURINT_SCRAPE_PROMOTER_AGENT_NAME=
ASURINT_AUTH_TOKEN_URL=
ASURINT_AUTH_CLIENT_ID=
ASURINT_AUTH_CLIENT_SECRET=
ASURINT_AUTH_API_KEY=
ASURINT_AUTH_TENANT_ID=
